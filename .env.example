# ==========================================
# Discord Bot Environment Configuration
# ==========================================

# [REQUIRED] Discord Bot Token from Discord Developer Portal
DISCORD_TOKEN=your_bot_token_here

# ==========================================
# OPTIONAL DEFAULTS
# Server settings can be configured directly in Discord using:
# !crossword config notify @CROSSWORD in #channel at 12:00
#
# The settings below act as fallback defaults when the bot joins a new server.
# ==========================================

# Default Channel ID for new servers (optional)
DISCORD_CHANNEL_ID=

# Default Role ID or Role Name to tag (default: "CROSSWORD")
CROSSWORD_ROLE_ID=CROSSWORD

# Default schedule time in Eastern Time (default: 12:00 PM ET)
SCHEDULE_HOUR_ET=12
SCHEDULE_MINUTE_ET=0
